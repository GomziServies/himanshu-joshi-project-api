# ==============================================================================
# TEMPLE WEB PLATFORM — BACKEND API ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000

# CORS Whitelist (Comma-separated allowed origins for customer portal and admin console)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:3001,http://127.0.0.1:5173,http://127.0.0.1:5174

# Authoritative MongoDB Database Connection URI
# Local MongoDB: mongodb://localhost:27017/mandir_platform
# Cloud MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/mandir_platform?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/mandir_platform

# Cryptographic JWT Authentication Secret (Minimum 32 random characters in production)
JWT_SECRET=super_secret_temple_platform_jwt_key_shree_shivling_2026_devotee_auth
JWT_EXPIRES_IN=7d

# Razorpay Payment Gateway Credentials
# Obtain test keys at https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere
# Set to 'true' to allow seamless checkout simulation when live keys are unavailable
DEMO_PAYMENT_ENABLED=true

# Automated Consecrated Email Receipts (Nodemailer / SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ethereal_user@ethereal.email
SMTP_PASS=ethereal_password
EMAIL_FROM="Shree Temple Offerings <offerings@temple.org>"

# DoS Protection & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Initial Bootstrap Administrator Credentials (Used for automatic database seeding)
ADMIN_DEFAULT_NAME="Sanctum Administrator"
ADMIN_DEFAULT_EMAIL="admin@temple.org"
ADMIN_DEFAULT_PASSWORD="Admin@Temple2026"
